# Backend API base URL (the UI appends /pipeline/code).
# Match this to the API host and port; the backend defaults to port 8080.
VITE_API_BASE_URL=http://localhost:8080/api/v1/agentic

# Optional shared bearer token for local development only.
# Vite embeds VITE_* values into browser code, so never put a production secret here.
# Prefer a server-side proxy or proper user authentication for a public deployment.
VITE_API_AUTH_TOKEN=
