# PostgreSQL application database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USERNAME=app
DB_PASSWORD=replace-with-a-strong-database-password

# PostgreSQL checkpoint database
DB_NAME_CHECKPOINT=checkpoint

# Application server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# Local Vite frontend origin. Set to an empty value to disable CORS.
CORS_ORIGINS=http://localhost:3000
API_AUTH_TOKEN=replace-with-a-random-secret-at-least-32-characters-long

# LLM provider
# Used for orchestration, research, and review agents.
PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Code generation: local uses Qwen + the adapter; groq avoids loading local model files.
CODE_GENERATION_PROVIDER=local

# Local Qwen code-generation model (only required when provider=local)
LOCAL_MODEL_BASE=Qwen/Qwen2.5-Coder-0.5B-Instruct
LOCAL_MODEL_ADAPTER=adapter
LOCAL_MODEL_MAX_NEW_TOKENS=768
LOCAL_MODEL_DEVICE=cpu
LOCAL_MODEL_TIMEOUT=180

# MCP servers
DUCK_DUCK_GO=http://localhost:8000/mcp
PYLINT_MCP_SERVER_URL=http://localhost:8001/mcp
PYLINT_WORKSPACE=/tmp/code-pipeline-review
