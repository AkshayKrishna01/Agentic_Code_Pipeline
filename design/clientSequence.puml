group func code_pipeline()
    
    group try block
        Service->Service:creates a checkpoint using db_uri
        Service->Service:set up the checkpointer where tables for checkpoint will be created if not exist
        Service->Service: create a variable config have thread_id as configurable value
        Service->Service:initialize state dictionary set state of user_query to user_query,thread_id to thread_id,code, context ,review ,status,route to empty string and retries to 0 and store it in agent_state variable
        Service->Service:call the built_graph method and store the result of compiled graph in self.graph
        group func _build_graph()
                group try Block
                    Service->Service:create StateGraph(AgentState) object and store it in variable workflow
                    group func decision_node(state)
                        Service->Service:invoke the llm in async manner with prepared  classification prompt with user_query and store the response in response variable
                        note over Service
                            Classify the user request into one of the categories below.
                            Categories:
                            - greet → greetings or small talk (hi, hello, hey, good morning, how are you, etc.)
                            - research → explanation needed or external knowledge about a library, language, or framework
                            - code → user asks to generate code directly
                            - review → user provides code and asks for review
                            - invalid → request is unclear, irrelevant, or asks for code review without providing code

                            Rules:
                            - If the message is a greeting or casual talk -> return greet
                            - If user asks for review but provides no code -> invalid
                            - If query does not fit any category -> invalid
                            - Greetings must NEVER be classified as invalid

                            Output format:
                            - For greet / research / code / review → return ONLY ONE WORD
                            - For invalid -> return in this exact format:
                            invalid: <clear reason>

                            Examples:
                            - Hi -> greet
                            - Review my code -> invalid: asked for code review but no code was provided
                            - Write a Python code for adding two number -> code
                        end note
                        Service->Service:extract content from response and normalize that using strip() and lower() and store it in response variable
                        alt **[response is greet]**
                            Service->Service: set the route of state to greet and code as Hello there! How can I assist you with code development
                        else **[if  decision is not  in any of this research, code, review,greet]**
                            Service->Service:return by updating the route of state as invalid and code as response
                        else **[ response is review]**
                            Service->Service:set the code state as user_query
                        end
                        Service->Service:update state of route to response  and return updated state
                    end 

                    group func research_node(state)
                        Service->Service: call the ask method of research agent and pass user query  and review extract from state, store the response in context variable
                        Service->Service:update state of context to context we got and return updated state
                    end 

                    group func code_node(state)

                        Service->Service: call the ask method of code agent and pass user query ,context and review extracted from state ,store the response in code variable
                        Service->Service:update state of code to code we got and return updated state

                    end 

                    group func review_node(state)
                        Service->Service: call the ask method of review tool and pass user query  and thread _id extract from state store the response in code variable
                        Service->Service: Initialize a variable status to fail
                        alt **[check review response content that it contains word like error or fix]**
                            Service->Service:set the status to fail
                        end 
        
                        alt **[status is  fail]**
                            Service->Service:increment retries to  retries plus one which got from state
                        end alt
                        Service->Service:update state of review to new review ,update state of status to new review status,update the retires of state with new retries 
                        Service-->Service:return updated state

                    end 

                    Service->Service:add node decide with decide_node to workflow graph
                    Service->Service:add node  research  with research_node to workflow graph
                    Service->Service:add node  code  with code_node to workflow graph
                    Service->Service:add node  review  with review_node to workflow graph

                    Service->Service:add edge START as decide to workflow graph

                    group func decide_route(state)
                        Service->Service:read state of route and return route value
                    end 

                    Service->Service:add conditional edges from decide to code,review or research or END for greet and invalid based on the decide route function returns
                    Service->Service:add edge goes from research to  code
                    Service->Service:add edge goes from code to review

                    group func review_route(state)

                        alt **[status is fail AND retries less than 3]**
                            Service-->Service:return "research" 
                        else **[status is  pass OR retries greater or equal to 3]**
                            Service-->Service:return END
                        end

                    end 
                    Service->Service:add conditional edges from review goes to research node or terminate(end) based on result of review_route function
                    Service->Service:compile graph into executable workflow object with checkpointer
                end 
                group except
                    activate Utils
                        Service->Utils:call the log error function and pass the file name,function name and exception
                    deactivate Utils  
                    Service-->Service:raise a error 
                end 
        end 
    
        alt **[if user asked to generate a code]**
                    activate CoderAgent
                    
                    group func ask()
                    group try
                        CoderAgent -> CoderAgent: call _run_agent and pass  question,context,review and store the result in final variable
                        group func _run_agent()
                        group try
                            CoderAgent -> CoderAgent: create LangChain agent provide model, empty list as tool and system prompt 
                            CoderAgent -> CoderAgent: invoke agent with HumanMessage as question ,context and review
                            CoderAgent -> CoderAgent: extract final message content from response and store it in final_content
                            CoderAgent --> CoderAgent: return the final_content
                        end 
                        group except
                            activate Utils
                                CoderAgent->Utils:call the log error function and pass the file name,function name and exception
                            deactivate Utils  
                            CoderAgent -> CoderAgent:raise a exception 
                        end
                        end 

                        CoderAgent --> CoderAgent: return final response
                    end 
                    group except

                        activate Utils
                                CoderAgent->Utils:call the log error function and pass the file name,function name and exception
                        deactivate Utils                    
                        CoderAgent -> CoderAgent:raise a exception 
                    end 
                end 
                end
                CoderAgent --> Service: return final response
                deactivate CoderAgent
                alt **[if wanted code review]**
                    activate ReviewAgent
                    group func ask()
                    group try
                        ReviewAgent ->ReviewAgent:create a variable temp_file and store the path of pylint workspace use Path function for coversion of string to path
                        ReviewAgent->ReviewAgent:create a variable as lines and split the given code into lines using splitlines method and store it in lines
                        alt **[len of the lines greater than 2]**
                            ReviewAgent->ReviewAgent:remove the first and last line of lines and store it in trimmed_code
                        else
                            ReviewAgent->ReviewAgent:store the lines as it is in trimmed_code
                        end 
