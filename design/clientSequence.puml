                        ReviewAgent -> ReviewAgent: create MultiServerMCPClient with server config such as transport mode as streamable_http and url
                        ReviewAgent -> ReviewAgent: open async session as pylint-server
                        ReviewAgent -> ReviewAgent: load_mcp_tools() using session and store it in tools variable
                        note over ReviewAgent
                        Pylint MCP is an MCP (Model Context Protocol) server designed to
                        perform code quality checks using Pylint. It enables developers to
                        analyze Python code for syntactic errors and style issues
                        Tools:
                        run_pylint_cmd — checks code quality, style, errors on a file/folder
                        run_symilar_cmd — finds duplicate or similar code blocks
                        run_full_report — runs both pylint and symilar together in one call
                        run_pyreverse_cmd — generates UML class diagrams
                        end note
                        ReviewAgent -> ReviewAgent: call _run_agent and pass question ,tools list ,file_path and store it in response variable
                        group func _run_agent()
                        group try
                            ReviewAgent -> ReviewAgent: create LangChain agent provide model, tools and system prompt
                            ReviewAgent -> ReviewAgent: invoke agent with HumanMessage as question and instruction with file_path
                            ReviewAgent -> ReviewAgent: extract final message content from response and store it in final_content
                            ReviewAgent -> ReviewAgent: return the final_content
                        end 
                        group except
                            activate Utils
                                ReviewAgent->Utils:call the log error function and pass the file name,function name and exception
                            deactivate Utils
                            ReviewAgent -> ReviewAgent:raise a exception 
                        end 
                        end 
                        ReviewAgent->ReviewAgent:return the response as string
                    end 
                    group except 
                        activate Utils
                            ReviewAgent->Utils:call the log error function and pass the file name,function name and exception
                        deactivate Utils
                        ReviewAgent -> ReviewAgent:raise a exception 
                    end 
                end 
                end
                ReviewAgent-->Service:return the response 
                deactivate ReviewAgent
                alt **[if wanted to research about anything library or concepts]**
                    activate ResearchAgent
                    group func ask()
                    group try

                        ResearchAgent -> ResearchAgent: create MultiServerMCPClient with server config
                        ResearchAgent -> ResearchAgent: open async session as duckduckgo

                        ResearchAgent -> ResearchAgent: load_mcp_tools() using session and store it in tools
                        note over ResearchAgent
                            The DuckDuckGo MCP server is a Model Context Protocol (MCP) 
                            server that connects DuckDuckGo’s search engine with AI agents 
                            allowing structured, programmatic web searches and content
                            fetching
                            Tools:
                            search — searches DuckDuckGo and returns titles, URLs, and snippets
                            fetch_content — fetches and extracts text from a webpage URL
                        end note
                        ResearchAgent -> ResearchAgent: call _run_agent and pass question, review_comments and tools list

                        group func _run_agent()
                        group try
                            ResearchAgent -> ResearchAgent: create LangChain agent provide model, tools and system prompt
                            ResearchAgent -> ResearchAgent: invoke agent with HumanMessage as question and review comment
                            ResearchAgent -> ResearchAgent: extract final message content from response and store it in final_content
                            ResearchAgent --> ResearchAgent: return final_content 
                        end 
                        group except
                            activate Utils
                                ResearchAgent->Utils:call the log error function and pass the file name,function name and exception
                            deactivate Utils
                            ResearchAgent -> ResearchAgent:raise a exception 
                        end 
                    end 
                        ResearchAgent-->ResearchAgent:return the final response 
                    end 
                    group except
                        activate Utils
                        ResearchAgent->Utils:call the log error function and pass the file name,function name and exception
                        deactivate Utils
                        ResearchAgent -> ResearchAgent:raise a exception 
                    end 
                end 
                deactivate ResearchAgent
                end
                ResearchAgent-->Service:return the final response to the service
        Service->Service:invoke compiled graph with agent_state and config
        Service->Service:get the code from state and store it in final reponse
        Service->Service:Form a dictionary consist of output_code as key and final_response as value
        Service ->Utils: Create success Response using success_reponse function pass the status="success",code="200",message="Codepipeline response generated"" and data and request_id
        activate Utils
        activate Model
            group func success_reponse()
                Utils -> Model:Make use of API Response model to create a success response pass all data to the model
                Model --> Utils: Return the model with thee respective data to the router
                Utils --> Utils: return the success response 
            end 
        deactivate Model
        Utils --> Service: return the success response 
        deactivate Utils
        Service -->Service : return the model got from success_response to the router            
    end 

    group ApplicationError Block
        activate Utils
            Service->Utils:call the log error function and pass the file name,function name and exception
                            group func log error()
                            activate Repository
                                            Utils->Repository:create a repository instance and store it in repo variable
                                            Utils->Utils: convert the exception to string and store it in error_message variable
                                            Utils->Utils: get the stack_trace from traceback and store it in stack_trace variable
                                            Utils->Utils:get the full error message with error_message and stack trace
                                            Utils->Repository: call the store_error method of repo and pass the file name, function name and full error
                                    group func store_error()
                                    Repository -> Repository: initialize session variable to None
                                    group try Block
                                            Repository -> Repository: call _get_session() and store result in session variable
                                            Repository -> Model: create a variable log and store the result of  ErrorLogs model pass the respective values to that
                                            activate Session
                                            activate Model
                                                Model-->Repository: a model is created with respective data and pass it to repository
                                            deactivate Model
                                            Repository->Session: add the log to the Database
                                            note over Session
                                                session.add(log)
                                            end note
                                        Repository->Repository: commit the session to save the changes
                                    end
                                    group except Block
                                        Repository -> Repository: rollback session, raise Database_error as Failed to log error
                                    end 
                                    group finally Block
                                        Repository -> Session: close session if open
