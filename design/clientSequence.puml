activate Main
group func run_local_server()
    group func initialize_config()
        group try Block
            Main -> Settings: Load Configuration from the settings
            activate Settings
            Settings -> Main: configuration will be sent to Main
            deactivate Settings
            Main -> Database: Initialize the Database by creating a instance
            activate Database
            Database -> Database: the init_db() is getting triggered engine initialized
            Database -> Database: initialize the session factory with the engine and set autoflush and autocommit to False
            Database --> Main: engine and session maker are initialized and ready
            deactivate Database
            Main -> Main: Setting log level for logging all operation of backend
            Main -> Main: return true to the run_local_server
        end 
        group except Block
            Main -> Main: If any Exception caught return false to the run_local_server
        end 
    end 

    alt **[Configuration initialization Failed]**
        Main -> Main: Initialization Failed application startup aborted
    end 
    Main->Database:call the test_connection function of db_connection
    activate Database
    group func db_connection()
        group try Block
            Database->Database:using the engine execute a select 1 query to test the db connection
            Database-->Database:return true after successfull connection test
        end 
        group except Block
         Database-->Database:return the false to main
        end 
    end 
    Database-->Main:return true or false
    deactivate Database
    alt **[db connection test failed]**
        Main->Main:Data Base connection failed aborted application start up
    end
    group try Block
        Main -> Migration: Create a instance of the Migration pass the Database class
        activate Migration
        Migration --> Main: Instance for Migration created, initialized Database and engine and passed to Main
        Main -> Migration: call the create_tables() method using the instance
        group func create_tables()
            group for Block
                Migration -> Migration: Iterate over all tables in array of table_order_creation
                alt **[Check the table exist if Not]**
                    Migration -> Migration: create table using engine
                end 
            end 
        end 
    end 
    group Exception Block
        Main->Main:log in console as Migration failed
    end 
    deactivate Migration
    Main->Main:create a variable app and store the result of create_app
    group func create_app()
        Main -> Main: FastApi app instance is created with title="Chatbot Api" version="1.0.0" and lifespan context manager attached
        Main -> Main: Register CORSMiddleware with (allowed_origins=["*"], methods=["GET", "POST", "PUT", "PATCH", "DELETE"])
        Main -> Main: Add the Exception handlers
        Main -> Router: calling app include_router(router, prefix="/api/v1", tags=["Chatbot"])
        activate Router
        Router -> Router: the include_router() is getting triggered routes are included
        Router --> Main: All Router registered successfully and now active and accept requests
        Main -> Main: Executes uvicorn.run() with host address, port, reload=true, log level configuration to start asgi server
        Main->Main : app instance will be returned
    end 
    Main->Main:using asyncio's run method run the serve method and run it in selectorEventLoop
    group func serve()
        Main->Main:configure the uvicorn with app instance in specified port and host,set reload to false, configure the log level and set access log to true
        Main->Main:create a variable server and store the initiliaized uvicorn with configuration
        Main->Main:run the server 
    end group
end 
